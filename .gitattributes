# The repo is authored on Windows but runs on Ubuntu 24.04. Without this,
# Git checks scripts out with CRLF and bash fails with:
#   /bin/bash^M: bad interpreter: No such file or directory
# Force LF in the repository and in the working tree for everything textual.
* text=auto eol=lf

*.sh        text eol=lf
Jenkinsfile text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf

*.png binary
*.jpg binary
